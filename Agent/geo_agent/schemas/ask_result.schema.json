{
  "$defs": {
    "AreaInfo": {
      "additionalProperties": true,
      "properties": {
        "handle": {
          "description": "The area's handle in this conversation, e.g. 'area-1'; also the area feature's id",
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "enum": [
            "circle",
            "polygon"
          ],
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/Center"
        },
        "radius_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A circle's radius",
          "title": "Radius Km"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A polygon's [min_lon, min_lat, max_lon, max_lat]",
          "title": "Bbox"
        }
      },
      "required": [
        "handle",
        "kind",
        "center"
      ],
      "title": "AreaInfo",
      "type": "object"
    },
    "Center": {
      "additionalProperties": true,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Center",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": true,
      "properties": {
        "level": {
          "description": "Support label; not a probability",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Level",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/ConfidenceBasis"
        }
      },
      "required": [
        "level",
        "basis"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceBasis": {
      "additionalProperties": true,
      "properties": {
        "max_edge_count": {
          "description": "Highest mention count of a relation supporting the answer",
          "title": "Max Edge Count",
          "type": "number"
        },
        "n_source_pages": {
          "description": "Distinct verified source pages",
          "title": "N Source Pages",
          "type": "integer"
        },
        "n_providers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Distinct source providers (Wikidata, EventKG, Wikipedia, ...) behind the evidence",
          "title": "N Providers"
        },
        "uncertain_match_used": {
          "description": "A weak or ambiguous name match was used",
          "title": "Uncertain Match Used",
          "type": "boolean"
        },
        "text_based_approximation": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present (true) when a concept was found only through text mentions",
          "title": "Text Based Approximation"
        }
      },
      "required": [
        "max_edge_count",
        "n_source_pages",
        "uncertain_match_used"
      ],
      "title": "ConfidenceBasis",
      "type": "object"
    },
    "ContextMismatch": {
      "additionalProperties": true,
      "properties": {
        "question_year": {
          "title": "Question Year",
          "type": "integer"
        },
        "start_date": {
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "title": "End Date",
          "type": "string"
        }
      },
      "required": [
        "question_year",
        "start_date",
        "end_date"
      ],
      "title": "ContextMismatch",
      "type": "object"
    },
    "DroppedId": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unknown",
            "not_in_tool_output"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "DroppedId",
      "type": "object"
    },
    "DroppedSet": {
      "additionalProperties": true,
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unknown",
            "not_in_tool_output"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "handle",
        "reason"
      ],
      "title": "DroppedSet",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "description": "Exception class name",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "description": "model_call, tool_call, step_limit, post_processing, unknown; from AgentRunner: timeout (stopped after the time limit), cancelled, busy (another question of the same thread_id was still running; this one did not run)",
          "enum": [
            "model_call",
            "tool_call",
            "step_limit",
            "structured_output",
            "post_processing",
            "unknown",
            "timeout",
            "cancelled",
            "busy"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "Feature",
          "title": "Type",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "properties": {
          "$ref": "#/$defs/FeatureProperties"
        }
      },
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "title": "Feature",
      "type": "object"
    },
    "FeatureCollection": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "FeatureCollection",
          "title": "Type",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "type",
        "features"
      ],
      "title": "FeatureCollection",
      "type": "object"
    },
    "FeatureProperties": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "Graph id; matches entity_ids",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Display name",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Node type, `location` today",
          "title": "Type",
          "type": "string"
        },
        "role": {
          "description": "`answer` when the feature (or the entity it is drawn for) answers the question; `area` for the area the user marked (spec R102); `path` for a timeline's directed line through its stops (spec R63)",
          "enum": [
            "answer",
            "context",
            "area",
            "path"
          ],
          "title": "Role",
          "type": "string"
        },
        "related_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present when the place is drawn on behalf of a non-spatial entity (event, org, person)",
          "title": "Related To"
        },
        "geometry_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'direct' when the entity's own geometry is drawn, 'related' when it is drawn at a linked place",
          "title": "Geometry Source"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set questions: the path that connects the place",
          "title": "Via"
        },
        "strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set questions: how well supported that path is (higher is stronger)",
          "title": "Strength"
        },
        "answer_for": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Answer people or units with no place of their own, shown at this site of a battle they took part in (role is then `answer`)",
          "title": "Answer For"
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order in a timeline or sequence (1, 2, 3...); draw it as a number (spec R63)",
          "title": "Seq"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A timeline stop's letter (A, B, C...); 'B, D' when a place is two stops",
          "title": "Label"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "stop",
                "span",
                "concurrent",
                "ongoing",
                "asked",
                "sequence",
                "cause",
                "effect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Phase M family state: a timeline `stop` or `span` (context, faint); `concurrent` or `ongoing` (context) during an event; the `asked` event; a `sequence` row, `cause` or `effect`",
          "title": "State"
        },
        "side": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order of battle: the side (1, 2) the entity or side feature belongs to",
          "title": "Side"
        },
        "side_via": {
          "anyOf": [
            {
              "enum": [
                "stated",
                "part_of"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`stated` by the relation; `part_of`: inferred from a parent unit on that side (draw dashed)",
          "title": "Side Via"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A timeline stop's start date (partial ISO)",
          "title": "Date"
        },
        "members": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A side feature's entity ids (type `side`)",
          "title": "Members"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "role"
      ],
      "title": "FeatureProperties",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ],
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "description": "GeoJSON coordinates, [longitude, latitude] order",
          "items": {},
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "OperationalInfo": {
      "additionalProperties": true,
      "properties": {
        "family": {
          "enum": [
            "trajectory",
            "concurrency",
            "order_of_battle",
            "sequence"
          ],
          "title": "Family",
          "type": "string"
        },
        "handle": {
          "description": "The result set it came from",
          "title": "Handle",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order of battle: the battle",
          "title": "Event Id"
        },
        "sides": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/OperationalSide"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Order of battle: one entry per side, for the legend",
          "title": "Sides"
        }
      },
      "required": [
        "family",
        "handle"
      ],
      "title": "OperationalInfo",
      "type": "object"
    },
    "OperationalSide": {
      "additionalProperties": true,
      "properties": {
        "side": {
          "title": "Side",
          "type": "integer"
        },
        "label": {
          "description": "The side's countries and services, e.g. 'United States / United States Navy'",
          "title": "Label",
          "type": "string"
        },
        "members": {
          "description": "Ids whose relation states this side",
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "inferred": {
          "description": "Ids placed on this side through a parent unit (side_via part_of)",
          "items": {
            "type": "string"
          },
          "title": "Inferred",
          "type": "array"
        }
      },
      "required": [
        "side",
        "label",
        "members",
        "inferred"
      ],
      "title": "OperationalSide",
      "type": "object"
    },
    "ResolvedEntity": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "typed": {
          "description": "The text the agent searched",
          "title": "Typed",
          "type": "string"
        },
        "matched_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Label"
        },
        "match": {
          "anyOf": [
            {
              "enum": [
                "name",
                "alias",
                "nickname",
                "hull_number",
                "alias_part",
                "fuzzy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "quality": {
          "enum": [
            "clear",
            "uncertain"
          ],
          "title": "Quality",
          "type": "string"
        },
        "model_rewritten_query": {
          "title": "Model Rewritten Query",
          "type": "boolean"
        },
        "model_reading": {
          "default": false,
          "description": "The model's own reading: the graph doesn't tie the user's words to this entity (e.g. a nickname the graph doesn't hold)",
          "title": "Model Reading",
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the graph holds the matched nickname: the alias or the text",
          "title": "Evidence"
        },
        "context_mismatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextMismatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "typed",
        "quality",
        "model_rewritten_query"
      ],
      "title": "ResolvedEntity",
      "type": "object"
    },
    "ResultSetInfo": {
      "additionalProperties": true,
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "total": {
          "description": "Members in the set; show this count",
          "title": "Total",
          "type": "integer"
        },
        "on_map": {
          "title": "On Map",
          "type": "integer"
        },
        "map_truncated": {
          "title": "Map Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "handle",
        "label",
        "total",
        "on_map",
        "map_truncated"
      ],
      "title": "ResultSetInfo",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": true,
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source system, e.g. 'Wikidata', 'EventKG', 'Wikipedia'",
          "title": "Provider"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the source assertion (never a Wikipedia page title)",
          "title": "Record Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link to the source record or page",
          "title": "Url"
        },
        "page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wikipedia page title, when the source is a Wikipedia page",
          "title": "Page"
        }
      },
      "title": "SourceRef",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": true,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dated_stops": {
          "description": "Stops with a date; say this number",
          "title": "Dated Stops",
          "type": "integer"
        },
        "stops": {
          "description": "In date order; draw numbered markers and the path",
          "items": {
            "$ref": "#/$defs/TimelineStop"
          },
          "title": "Stops",
          "type": "array"
        },
        "spans": {
          "description": "Campaigns holding the stops: context, drawn faintly",
          "items": {
            "$ref": "#/$defs/TimelineRow"
          },
          "title": "Spans",
          "type": "array"
        },
        "undated": {
          "description": "Events with no date: list as 'date unknown', never on the path",
          "items": {
            "$ref": "#/$defs/TimelineRow"
          },
          "title": "Undated",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "LineString through the stops in order (longitudes continuous across 180°); null under 2 stops"
        }
      },
      "required": [
        "entity_id",
        "name",
        "dated_stops",
        "stops",
        "spans",
        "undated",
        "path"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "TimelineRow": {
      "additionalProperties": true,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "place_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Place Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "TimelineRow",
      "type": "object"
    },
    "TimelineStop": {
      "additionalProperties": true,
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "label": {
          "description": "A, B, C...: the marker label",
          "title": "Label",
          "type": "string"
        },
        "date": {
          "description": "Partial ISO date, with its precision",
          "title": "Date",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "date_precision": {
          "anyOf": [
            {
              "enum": [
                "day",
                "month",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Precision"
        },
        "place_ids": {
          "description": "Places of the stop; [] when the event is placed only by its own point",
          "items": {
            "type": "string"
          },
          "title": "Place Ids",
          "type": "array"
        },
        "event_ids": {
          "description": "Events merged into this stop; [] for a stay (based at, landed at)",
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "seq",
        "label",
        "date",
        "place_ids",
        "event_ids"
      ],
      "title": "TimelineStop",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "args": {
          "description": "Tool arguments, usually an object",
          "title": "Args"
        }
      },
      "required": [
        "name",
        "args"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "One reply of the agent. Every key is present in every reply, including errors.",
  "properties": {
    "schema_version": {
      "description": "Version of this contract, e.g. '1.0'",
      "title": "Schema Version",
      "type": "string"
    },
    "answer": {
      "description": "Chat text; may contain Markdown. Untrusted: render sanitized, never as raw HTML. Empty on error.",
      "title": "Answer",
      "type": "string"
    },
    "answer_ids": {
      "description": "Entities that answer the question; highlight these",
      "items": {
        "type": "string"
      },
      "title": "Answer Ids",
      "type": "array"
    },
    "context_ids": {
      "description": "Other entities the answer mentions; show more quietly",
      "items": {
        "type": "string"
      },
      "title": "Context Ids",
      "type": "array"
    },
    "entity_ids": {
      "description": "answer_ids followed by context_ids",
      "items": {
        "type": "string"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "sources": {
      "description": "Wikipedia page titles the answer relies on (never record ids)",
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "source_refs": {
      "description": "Structured provenance of the answer's evidence (at most 25); [] when none",
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "geojson": {
      "$ref": "#/$defs/FeatureCollection"
    },
    "bbox": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "description": "[min_lon, min_lat, max_lon, max_lat] around the map features; null without features. min_lon > max_lon means the box crosses the 180° meridian (for Leaflet fit_bounds, add 360 to max_lon).",
      "title": "Bbox"
    },
    "center": {
      "anyOf": [
        {
          "$ref": "#/$defs/Center"
        },
        {
          "type": "null"
        }
      ],
      "description": "Middle of bbox, for the initial map view; null without features"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "run_id": {
      "description": "Trace id: `uv run geo-agent --trace <run_id>`",
      "title": "Run Id",
      "type": "string"
    },
    "warnings": {
      "description": "Warning codes; open set, see README",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "dropped_ids": {
      "items": {
        "$ref": "#/$defs/DroppedId"
      },
      "title": "Dropped Ids",
      "type": "array"
    },
    "unverified_sources": {
      "items": {
        "type": "string"
      },
      "title": "Unverified Sources",
      "type": "array"
    },
    "unverified_numbers": {
      "items": {
        "type": "number"
      },
      "title": "Unverified Numbers",
      "type": "array"
    },
    "ungrounded_names": {
      "description": "Graph entities the answer names although no tool returned them (the model added them from its own knowledge); warning ungrounded_names",
      "items": {
        "type": "string"
      },
      "title": "Ungrounded Names",
      "type": "array"
    },
    "resolved_entities": {
      "items": {
        "$ref": "#/$defs/ResolvedEntity"
      },
      "title": "Resolved Entities",
      "type": "array"
    },
    "interpretation": {
      "description": "How names were read when not literal; show to the user",
      "items": {
        "type": "string"
      },
      "title": "Interpretation",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "result_sets": {
      "items": {
        "$ref": "#/$defs/ResultSetInfo"
      },
      "title": "Result Sets",
      "type": "array"
    },
    "dropped_sets": {
      "items": {
        "$ref": "#/$defs/DroppedSet"
      },
      "title": "Dropped Sets",
      "type": "array"
    },
    "area": {
      "anyOf": [
        {
          "$ref": "#/$defs/AreaInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "The marked map area this answer used (spec R102); null without one"
    },
    "timeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timeline"
        },
        {
          "type": "null"
        }
      ],
      "description": "A unit's, person's or ship's path (spec R63); null without one"
    },
    "operational": {
      "description": "Phase M families in this answer and how to draw them (spec R63); [] when none",
      "items": {
        "$ref": "#/$defs/OperationalInfo"
      },
      "title": "Operational",
      "type": "array"
    },
    "ungrounded_dates": {
      "description": "Years in an operational answer that no tool result holds (spec R64); warning ungrounded_dates",
      "items": {
        "type": "string"
      },
      "title": "Ungrounded Dates",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "null on success"
    }
  },
  "required": [
    "schema_version",
    "answer",
    "answer_ids",
    "context_ids",
    "entity_ids",
    "sources",
    "source_refs",
    "geojson",
    "bbox",
    "center",
    "tool_calls",
    "run_id",
    "warnings",
    "dropped_ids",
    "unverified_sources",
    "unverified_numbers",
    "ungrounded_names",
    "resolved_entities",
    "interpretation",
    "confidence",
    "result_sets",
    "dropped_sets",
    "area",
    "timeline",
    "operational",
    "ungrounded_dates",
    "error"
  ],
  "title": "AskResult",
  "type": "object",
  "$id": "geo_agent/ask_result/1.7"
}
