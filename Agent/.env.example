# Copy to .env and fill in.
OPENROUTER_API_KEY=
# Any OpenRouter model slug with tool-calling support.
GEO_AGENT_MODEL=z-ai/glm-5.2
# Knowledge-graph JSON produced by the graph pipeline.
# The self-fixed graph (Git LFS: run `git lfs pull`; see data/partof521/README.md). Mock mode always uses the sample graph.
GRAPH_PATH=data/partof521/graph.selffix.json
MCP_CONFIG_PATH=mcp_servers.json
