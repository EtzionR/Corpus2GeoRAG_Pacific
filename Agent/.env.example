# Copy to .env and fill in.
OPENROUTER_API_KEY=
# Any OpenRouter model slug with tool-calling support.
GEO_AGENT_MODEL=z-ai/glm-5.2
# Knowledge-graph JSON produced by the graph pipeline.
# The graph to use is graph.selffix.json, built by graph_enrichment (see README); the sample graph is for tests and mock mode.
GRAPH_PATH=data/sample_graph.json
MCP_CONFIG_PATH=mcp_servers.json
